#include <stdio.h>

int main() {
    int i, n, tq, time, np;
    int AT[20], BT[20], CT[20], TAT[20], WT[20], RT[20];
    int stat = 0, swt = 0;
    char P[20];

    printf("enter number of processes: ");
    scanf("%d", &n);

    printf("enter process name: ");
    for(i = 0; i < n; i++) {
        scanf(" %c", &P[i]);
    }

    printf("enter arrival times: ");
    for(i = 0; i < n; i++) {
        scanf("%d", &AT[i]);
    }

    printf("enter burst times: ");
    for(i = 0; i < n; i++) {
        scanf("%d", &BT[i]);
        RT[i] = BT[i];
    }

    printf("enter the time quantum slice: ");
    scanf("%d", &tq);

    time = 0;
    np = n;

    while(np > 0) {
        int a = 0;

        for(i = 0; i < n; i++) {
            if(AT[i] <= time && RT[i] > 0) {
                a = 1;

                if(RT[i] <= tq) {
                    time = time + RT[i];
                    RT[i] = 0;
                    CT[i] = time;
                    np--;
                }
                else {
                    time = time + tq;
                    RT[i] = RT[i] - tq;
                }
            }
        }

        if(a == 0) {
            time++;
        }
    }

    for(i = 0; i < n; i++) {
        TAT[i] = CT[i] - AT[i];
        WT[i] = TAT[i] - BT[i];
        stat += TAT[i];
        swt += WT[i];
    }

    float atat = (float)stat / n;
    float awt = (float)swt / n;

    printf("\nProcess\tAT\tBT\tCT\tTAT\tWT\n");

    for(i = 0; i < n; i++) {
        printf("%c\t%d\t%d\t%d\t%d\t%d\n",
               P[i], AT[i], BT[i], CT[i], TAT[i], WT[i]);
    }

    printf("\nAverage Turnaround Time = %.2f", atat);
    printf("\nAverage Waiting Time = %.2f", awt);

    return 0;
}
