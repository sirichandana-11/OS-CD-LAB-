#include <stdio.h>
#include <string.h>
#include <ctype.h>
#include<conio.h>

char p[30][30], F[26][30]; int n;

void add(int A,char x){
    if(!strchr(F[A],x)){
        int k=strlen(F[A]); F[A][k]=x; F[A][k+1]='\0';
    }
}

int main(){
    int i,j,k,ch;
    printf("No. of productions: "); scanf("%d",&n);
    printf("Enter productions (A=BCD, #=epsilon):\n");
    for(i=0;i<n;i++) scanf("%s",p[i]);

    do{
        ch=0;
        for(i=0;i<n;i++){
            int A=p[i][0]-'A', nul=1;
            for(j=2;p[i][j]&&nul;j++){
                char x=p[i][j];
                if(!isupper(x)){
                    if(!strchr(F[A],x)){add(A,x);ch=1;}
                    nul=(x=='#');
                }else{
                    int B=x-'A';
                    for(k=0;F[B][k];k++)
                        if(F[B][k]!='#'&&!strchr(F[A],F[B][k]))
                            add(A,F[B][k]),ch=1;
                    nul=strchr(F[B],'#')!=NULL;
                }
            }
            if(nul&&!strchr(F[A],'#')) add(A,'#'),ch=1;
        }
    }while(ch);

    printf("\nFIRST Sets:\n");
    for(i=0;i<n;i++)
        if(i==0||p[i][0]!=p[i-1][0])
            printf("FIRST(%c)={%s}\n",p[i][0],F[p[i][0]-'A']);
getch();
    return 0;
}

